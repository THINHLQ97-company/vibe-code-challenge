# Database
DATABASE_URL=postgres://app:app@localhost:5432/matbao-vibe-challenge

# Auth (JWT tự viết — không dùng NextAuth, để dễ swap sang MS365 OAuth ở Phase 2)
JWT_SECRET=change-me-min-32-chars

# API key cho hệ chấm điểm ngoài đẩy điểm về (Phase 1 + Phase 2) — POST /api/integrations/scores
SCORING_API_KEY=change-me

# GitHub machine-user account dùng để verify collaborator ở Phase 2 (matbao-vibe-bot)
GITHUB_BOT_PAT=change-me

# Add your env vars here (document mỗi biến)
