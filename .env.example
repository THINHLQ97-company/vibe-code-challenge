# Database
DATABASE_URL=postgres://app:app@localhost:5432/matbao-vibe-challenge

# Auth (JWT tự viết — không dùng NextAuth, để dễ swap sang MS365 OAuth ở Phase 2)
JWT_SECRET=change-me-min-32-chars

# API key cho hệ chấm điểm ngoài đẩy điểm về (Phase 1 + Phase 2) — POST /api/integrations/scores
SCORING_API_KEY=change-me

# Add your env vars here (document mỗi biến)

# ─── Đăng nhập bằng tài khoản Microsoft công ty (Entra ID) ─────────────────────────────────
# Ba giá trị do đội quản lý tenant Microsoft cấp khi đăng ký ứng dụng. Đăng ký dạng nền tảng
# **Web** (KHÔNG phải SPA) — app trao đổi mã lấy token ở phía máy chủ và giữ phiên trong cookie
# httpOnly. Thiếu bất kỳ biến nào thì nút "Đăng nhập bằng Microsoft" tự ẩn đi.
# Để nguyên "change-me" nếu chưa có: app coi giá trị giữ chỗ là CHƯA cấu hình và tự ẩn
# nút đăng nhập Microsoft. Nền tảng lưu trữ chặn deploy khi biến trong file này bỏ trống,
# nên phải có giá trị chứ không được để rỗng.
AZURE_AD_TENANT_ID=change-me
AZURE_AD_CLIENT_ID=change-me
AZURE_AD_CLIENT_SECRET=change-me

# Địa chỉ gốc công khai của ứng dụng, KHÔNG có dấu / ở cuối.
# Bắt buộc đặt ở môi trường chạy thật: redirect URI phải trùng TỪNG KÝ TỰ với chuỗi đã đăng ký
# bên Entra, mà sau proxy thì địa chỉ suy từ request là địa chỉ nội bộ (http, cổng 3000).
# Ví dụ: https://vibecodechallenge.matbao.ai
APP_BASE_URL=http://localhost:3000
